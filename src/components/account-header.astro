---
import BrandLockup from "@/components/brand-lockup.astro";
import {
  Alien01Icon,
  Astronaut01Icon,
  BubbleTea01Icon,
  Cupcake02Icon,
  GalaxyIcon,
  GameController02Icon,
  RainbowIcon,
  Rocket01Icon,
  RollerSkateIcon,
  SparklesIcon,
} from "@hugeicons-pro/core-bulk-rounded";
import { HugeiconsIcon } from "@hugeicons/react";

const icons = [
  Alien01Icon,
  Astronaut01Icon,
  Rocket01Icon,
  GalaxyIcon,
  RainbowIcon,
  SparklesIcon,
  Cupcake02Icon,
  BubbleTea01Icon,
  GameController02Icon,
  RollerSkateIcon,
] as const;

const marqueeIcons = [...icons, ...icons];
---

<header class="overflow-hidden border-b border-gray-950/10 bg-white">
  <div class="flex w-full items-center gap-5 p-4 pr-0 sm:gap-8 sm:p-6 sm:pr-0">
    <BrandLockup account />
    <div class="account-icon-rail relative min-w-0 flex-1 overflow-hidden">
      <div class="account-icon-track flex w-max items-center gap-7 sm:gap-9">
        {
          marqueeIcons.map((icon) => (
            <HugeiconsIcon
              aria-hidden="true"
              className="size-9 shrink-0 opacity-20 sm:size-11"
              color="currentColor"
              icon={icon}
              size={44}
            />
          ))
        }
      </div>
    </div>
  </div>
</header>

<style>
  @keyframes account-icon-marquee {
    from {
      transform: translateX(-50%);
    }

    to {
      transform: translateX(0);
    }
  }

  .account-icon-track {
    animation: account-icon-marquee 72s linear infinite;
    will-change: transform;
  }

  .account-icon-rail {
    mask-image: linear-gradient(90deg, transparent 0%, black 18%, black 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 18%, black 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .account-icon-track {
      animation: none;
      transform: translateX(0);
    }
  }
</style>
