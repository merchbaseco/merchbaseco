---
import { AccountApp } from "@/components/account/account-app";
import AccountLayout from "@/layouts/account-layout.astro";
---

<AccountLayout description="Review access to your Merchbase products." title="Product access">
  <AccountApp
    accessOrigin={import.meta.env.PUBLIC_ACCESS_API_ORIGIN}
    client:only="react"
    publishableKey={import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY}
    section="access"
  >
    <div class="h-80 animate-pulse rounded-xl bg-gray-100" slot="fallback"></div>
  </AccountApp>
</AccountLayout>
